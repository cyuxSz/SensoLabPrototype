{
  "name": "sensolab-sensory-passport",
  "private": true,
  "version": "1.0.0",
  "workspaces": ["client", "server", "shared"],
  "scripts": {
    "dev": "concurrently -k -n client,server \"npm run dev --workspace=client\" \"npm run dev --workspace=server\"",
    "dev:vercel": "vercel dev",
    "build": "npm run build --workspace=client",
    "build:server": "npm run build --workspace=server",
    "typecheck": "npm run typecheck --workspace=server && npm run typecheck --workspace=client",
    "seed": "tsx scripts/seed-redis.ts",
    "upload:models": "tsx scripts/upload-models.ts"
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4"
  }
}